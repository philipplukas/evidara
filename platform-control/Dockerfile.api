# Optional slim API-only image (context: platform-control/). CI and platform-control/cloudbuild.api.yaml
# use the repo-root build in Dockerfile (monorepo copy) to match runtime-images.yml.
FROM python:3.12-slim@sha256:804ddf3251a60bbf9c92e73b7566c40428d54d0e79d3428194edf40da6521286

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

EXPOSE 8080

CMD ["sh", "-c", "uvicorn platform_control.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
