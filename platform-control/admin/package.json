{
  "name": "@evidara/platform-control-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node ../../scripts/ensure-monorepo-shared-modules.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src/ e2e/ playwright.config.ts",
    "format": "biome check --write src/ e2e/ playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:browsers": "playwright install chromium",
    "e2e:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-admin": "^5.14.5",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
