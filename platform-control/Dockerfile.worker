FROM python:3.12-slim@sha256:804ddf3251a60bbf9c92e73b7566c40428d54d0e79d3428194edf40da6521286

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY platform-control/ ./platform-control/
COPY document-intelligence/ ./document-intelligence/

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ./document-intelligence \
    && pip install --no-cache-dir ./platform-control

CMD ["platform-control-connector-worker"]
