    {
      "question": "Is the transition-dependent temporal variation low-dimensional?",
      "ground_truth": {
        "latent rank": 2,
        "latent R_1": 0.9997770199530124
      },
      "estimate": {
        "R_1": 0.9995983151120628,
        "R_2": 0.9998945983756156,
        "R_3": 0.9999236796512505
      },
      "error": 0.00010540162438443801,
      "status": "IDENTIFIABLE",
      "control": "permuted-label null: top null singular value is 0.024 of s_1",
      "notes": "R_1 = 0.99960 already at noise scale 0.1 -- one temporal component carries almost everything. The generative rank is 2, but the second mode holds only 0.030% of the energy because the two damped responses are nearly collinear curves.",
      "error_label": "1 - R_2"
    },
    {
      "question": "How many temporal components are detectable above the noise floor?",
      "ground_truth": {
        "generative modes": 2
      },
      "estimate": {
        "0.03": 1,
        "0.1": 1,
        "0.3": 1,
        "1.0": 1
      },
      "error": null,
      "status": "PARTIALLY IDENTIFIABLE",
      "control": "95th percentile of the top singular value over 20 label permutations",
      "notes": "detected counts by noise scale: {0.03: 1, 0.1: 1, 0.3: 1, 1.0: 1}; the true count 2 is recovered at no noise scale(s). Low-dimensionality is easy to confirm; the exact dimension is not, because a near-collinear second mode becomes statistically invisible long before it becomes physically absent.",
      "error_label": "n/a (count)"
    },
    {
      "question": "Does the recovered temporal rank track the articulatory dimension d_art?",
      "ground_truth": {
        "2": 2,
        "3": 3,
        "5": 5
      },
      "estimate": {
        "2": 2,
        "3": 3,
        "5": 3
      },
      "error": null,
      "status": "PARTIALLY IDENTIFIABLE",
      "control": "noiseless data, so any shortfall is collinearity rather than noise",
      "notes": "counted on clean acoustics as the number of singular values above 1e-3 of the first: d_art=2 -> 2, d_art=3 -> 3, d_art=5 -> 3. Dropping the threshold to 1e-6 gives 2 -> 5, 3 -> 6, 5 -> 6. The count is threshold-dependent and under-reports d_art at every d tested, so 'how many temporal modes' is not answerable by a variance rule alone.",
      "error_label": "n/a (count)"
    }
