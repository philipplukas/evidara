# =============================================================================
# Evidara Monorepo .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
!infra/env/
!infra/env/**/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
platform-control/.data/
platform-control/*.db

# --- Node / JavaScript / TypeScript ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
!infra/env/**/*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# --- Databricks ---
.databricks/
*.dbc

# --- direnv (local) ---
.envrc

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.local
.env.*.local
.evidara-cloud-run.env
*.pem
*.key
secrets/
!secrets/.gitkeep

# --- Logs ---
logs/
*.log

# --- Generated files ---
generated/
!legal-search/api/src/lib/document-intelligence/generated/
!legal-search/api/src/lib/document-intelligence/generated/**
!legal-search/frontend/src/lib/api/generated/
!legal-search/frontend/src/lib/api/generated/**
*.generated.*

# --- Build outputs ---
dist/
build/
target/
# MkDocs default output (`mkdocs build`, `scripts/check_docs.sh`); do not commit
site/

# --- Operator-local scripts (host-specific paths / IPs; not part of default clone) ---
scripts/deploy-hetzner-runner.sh
