# =============================================================================
# Evidara Monorepo .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Node / JavaScript / TypeScript ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# --- Databricks ---
.databricks/
*.dbc

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
!secrets/.gitkeep

# --- Logs ---
logs/
*.log

# --- Generated files ---
generated/
*.generated.*

# --- Build outputs ---
dist/
build/
target/
