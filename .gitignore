# =============================================================================
# Evidara Monorepo .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
!infra/env/
!infra/env/**/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
platform-control/.data/
platform-control/*.db
# Cached `temporal-test-server` binary for the time-skipping test env (#564).
platform-control/.temporal-test-server/

# --- Node / JavaScript / TypeScript ---
node_modules/
# Match the monorepo-root `node_modules` symlink created by
# `scripts/ensure-monorepo-shared-modules.mjs` (postinstall on each
# surface). The trailing-slash form above only matches real directories.
/node_modules
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
!infra/env/**/*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# --- Databricks ---
.databricks/
*.dbc

# --- direnv (local) ---
.envrc

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.local
.env.*.local
.evidara-cloud-run.env
*.pem
*.key
secrets/
!secrets/.gitkeep

# --- Logs ---
logs/
*.log

# --- Generated files ---
generated/
!legal-search/api/src/lib/document-intelligence/generated/
!legal-search/api/src/lib/document-intelligence/generated/**
!legal-search/frontend/src/lib/api/generated/
!legal-search/frontend/src/lib/api/generated/**
# The admin's contract types must be tracked or its `openapi:check` gate is
# vacuous: `git diff --exit-code` never reports an ignored file, so drift would
# pass silently — the exact failure mode ADR-0045 exists to close.
!platform-control/admin/src/lib/api/generated/
!platform-control/admin/src/lib/api/generated/**
*.generated.*
# Exception: the DI published-source contract YAML is rendered from Python but
# checked in. A unit test keeps it in sync with surfaces.py, and dbt needs it
# on disk to register the source-level column contract tests.
!document-intelligence/dbt/models/sources_published.generated.yml

# dbt local artifacts
document-intelligence/dbt/.user.yml
document-intelligence/dbt/dbt_packages/
document-intelligence/dbt/target/
document-intelligence/dbt/logs/

# --- Build outputs ---
dist/
build/
target/
# MkDocs default output (`mkdocs build`, `scripts/check_docs.sh`); do not commit
site/

# --- Operator-local scripts (host-specific paths / IPs; not part of default clone) ---
scripts/deploy-hetzner-runner.sh

# Pnpm store artifacts from local Docker runs
.pnpm-store/

# --- Claude Code agent harness ---
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# macOS Spotlight "do not index" markers
.metadata_never_index
