# Required
NODE_ENV=development
PORT=3001

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_DOCUMENTS=evidara-documents-v1
OPENSEARCH_INDEX_SECTIONS=evidara-sections-v1

# Document Service (document-intelligence read API — optional)
# When set, GET /v1/documents/:id overlays lean Docling JSON from GET {base}/v1/documents/{id}/lean
# DOCUMENT_INTELLIGENCE_BASE_URL=http://localhost:8090
# DOCUMENT_INTELLIGENCE_BEARER_TOKEN=

# Auth (JWT verification)
# JWT_PUBLIC_KEY=<base64-encoded-public-key>
