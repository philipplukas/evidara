# Required
NODE_ENV=development
PORT=3102

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_INDEX_DOCUMENTS=evidara-documents-v1
OPENSEARCH_INDEX_SECTIONS=evidara-sections-v1

# Auth (service-to-service API key — ADR-0020)
# Fails CLOSED: with API_KEY unset and no dev opt-in, every non-@Public() route
# returns 503. Health endpoints stay reachable either way.
AUTH_DEV_ALLOW_UNAUTHENTICATED=1
# ^ LOCAL DEVELOPMENT ONLY. Never set this in a deployed environment.
# API_KEY=<shared secret the BFF middleware injects as X-API-Key>
#
# NOTE: there is no JWT verification in this service. A `JWT_PUBLIC_KEY` used to be
# listed here; nothing reads it. Per-user identity is designed in ADR-0038.

# Document Intelligence — Document Service (ADR-0010; sync reads for document body)
# DOCUMENT_INTELLIGENCE_BASE_URL=http://localhost:8082
# Optional when service-to-service auth is enabled:
# DOCUMENT_INTELLIGENCE_API_KEY=
