{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/events/raw-artifact-available",
  "title": "RawArtifactAvailable",
  "description": "Event emitted by platform-control when a raw artifact has been durably stored and is ready for downstream processing.",
  "allOf": [
    {
      "$ref": "https://evidara.dev/common/event-envelope"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "raw_artifact.available"
        },
        "event_version": {
          "const": 1
        },
        "producer": {
          "const": "platform-control"
        },
        "payload": {
          "type": "object",
          "required": [
            "artifact_id",
            "source_id",
            "source_version_id",
            "run_id",
            "storage_path",
            "content_type",
            "created_at"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^art_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "source_id": {
              "type": "string",
              "pattern": "^src_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "source_version_id": {
              "type": "string",
              "pattern": "^sv_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^run_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "storage_path": {
              "type": "string",
              "description": "URI or path to the stored raw artifact."
            },
            "content_type": {
              "type": "string",
              "description": "MIME type of the stored artifact."
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp of when the artifact was created."
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true,
              "description": "Optional provider-specific metadata captured with the artifact."
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
