{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/events/index-update-requested",
  "title": "IndexUpdateRequested",
  "description": "Event emitted to request legal-search to update its OpenSearch projections. Used for targeted replay, index rebuilds, and operational backfills.",
  "allOf": [
    {
      "$ref": "https://evidara.dev/common/event-envelope"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "index_update.requested"
        },
        "event_version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "tenant_id",
            "corpus_id",
            "scope_type",
            "scope"
          ],
          "properties": {
            "tenant_id": {
              "type": "string",
              "pattern": "^tenant_[a-z0-9_]+$"
            },
            "corpus_id": {
              "type": "string",
              "pattern": "^corpus_[a-z0-9_]+$"
            },
            "scope_type": {
              "type": "string",
              "enum": [
                "global_public",
                "tenant_private",
                "tenant_shared"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "full",
                "incremental",
                "document"
              ]
            },
            "document_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$"
              }
            },
            "projection_version": {
              "type": "string",
              "description": "Projection version that should be built or rebuilt."
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
