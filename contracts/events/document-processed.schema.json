{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/events/document-processed",
  "title": "DocumentProcessed",
  "description": "Event emitted by document-intelligence when one logical document revision becomes canonical-ready and safe for downstream consumption.",
  "allOf": [
    {
      "$ref": "https://evidara.dev/common/event-envelope"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "document.processed"
        },
        "event_version": {
          "const": 1
        },
        "producer": {
          "const": "document-intelligence"
        },
        "payload": {
          "type": "object",
          "required": [
            "document_id",
            "document_revision",
            "processing_manifest_id",
            "processing_version",
            "provenance",
            "lifecycle_status",
            "published_document_ref",
            "published_sections_ref",
            "processing_manifest_ref"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "document_revision": {
              "type": "integer",
              "minimum": 1
            },
            "processing_manifest_id": {
              "type": "string",
              "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "processing_version": {
              "type": "string"
            },
            "provenance": {
              "$ref": "https://evidara.dev/common/provenance"
            },
            "authority_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^auth_[a-z0-9_]+$"
            },
            "authority_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_official": {
              "type": "boolean",
              "description": "Whether the canonical document came from an official source origin."
            },
            "lifecycle_status": {
              "type": "string",
              "enum": [
                "active",
                "superseded",
                "repealed",
                "withdrawn"
              ]
            },
            "published_document_ref": {
              "$ref": "https://evidara.dev/common/dataset-ref"
            },
            "published_sections_ref": {
              "$ref": "https://evidara.dev/common/dataset-ref"
            },
            "processing_manifest_ref": {
              "$ref": "https://evidara.dev/common/manifest-ref"
            },
            "supersedes_processing_manifest_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "stages": {
              "type": "array",
              "description": "Per-stage timings and counts, denormalised from the processing manifest so the control plane can render them without reading the lakehouse. Same shape and same caveats as `processing-manifest.schema.json#/properties/stages`: timings and counts ONLY — an entry does NOT say what the stage removed from the text (ADR-0044). An absent or empty array means the producer did not record stages, NOT that no stages ran, so a consumer must render absence as 'not recorded' rather than as zero work.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "duration_us"],
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "normalize",
                      "sectionize",
                      "extract",
                      "assemble",
                      "enrich",
                      "finalize"
                    ]
                  },
                  "duration_us": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Elapsed microseconds. Microseconds, not milliseconds: measured 2026-09-06 every stage of a small HTML document reported 0 ms, which a reader cannot distinguish from \"not measured\" \u2014 the exact absence-versus-zero conflation this ledger exists to avoid."
                  },
                  "items_in": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "items_out": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "boolean"
                  },
                  "error_type": {
                    "type": "string"
                  },
                  "details": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
