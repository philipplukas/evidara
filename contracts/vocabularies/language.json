      "iso639_1": "fr",
      "iso639_2_b": "fre",
      "iso639_2_t": "fra"
    },
    "it": {
      "prefLabel": { "de": "Italienisch", "fr": "Italien", "it": "Italiano", "en": "Italian" },
      "iso639_1": "it",
      "iso639_2_b": "ita",
      "iso639_2_t": "ita"
    },
    "en": {
      "prefLabel": { "de": "Englisch", "fr": "Anglais", "it": "Inglese", "en": "English" },
      "iso639_1": "en",
      "iso639_2_b": "eng",
