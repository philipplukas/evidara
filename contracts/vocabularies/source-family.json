{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/vocabularies/source-family",
  "title": "Source Family Vocabulary",
  "description": "Canonical source-family tokens for Evidara. Aligned with the EU ELI `legal_type` vocabulary (http://publications.europa.eu/ontology/eli) and Akoma Ntoso document-class hierarchy. The UI-facing canonical set is {law, decision, commentary, rechtssatz}; the ELI-aligned richer set sits as siblings, each with `broader` pointing back to the short canonical set so projections can collapse or expand as needed.",
  "vocabulary": "source_family",
  "values": {
