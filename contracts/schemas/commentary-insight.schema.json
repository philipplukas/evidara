{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/schemas/commentary-insight",
  "title": "CommentaryInsight",
  "description": "Non-canonical extractive commentary insight produced by document-intelligence. The durable unit is a supported legal proposition or authority anchor, not generated legal advice.",
  "type": "object",
  "required": [
    "insight_id",
    "document_id",
    "document_revision",
    "processing_manifest_id",
    "record_kind",
    "insight_type",
    "claim",
    "display_text",
    "support",
    "referenced_authorities",
    "jurisdiction_ids",
    "authority_ids",
    "source_document_ids",
    "confidence",
    "review_state",
    "generator",
    "scores"
  ],
  "properties": {
    "record_kind": {
      "type": "string",
      "description": "Discriminator marking this record as a commentary insight when joined into the legal-search projection.",
      "const": "commentary_insight"
    },
    "insight_id": {
      "type": "string",
      "description": "Stable commentary insight identifier.",
      "pattern": "^ins_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "document_id": {
      "type": "string",
      "description": "Document that produced the insight.",
      "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "document_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Document revision that produced the insight."
    },
    "processing_manifest_id": {
      "type": "string",
      "description": "Processing result that produced the insight.",
      "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "section_id": {
      "type": ["string", "null"],
      "description": "Section that contains the extractive support when localized.",
      "pattern": "^sec_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "citation_id": {
      "type": ["string", "null"],
      "description": "Citation entity that anchors the insight when available.",
      "pattern": "^cit_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "insight_type": {
      "type": "string",
      "description": "Small v1 taxonomy for extractive commentary anchors.",
      "enum": ["commentary_anchor", "referenced_provision", "authority_link"]
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "Short extractive proposition or normalized authority label."
    },
    "display_text": {
      "type": "string",
      "minLength": 1,
      "description": "Source passage snippet only. This must come from the source text, not generated legal prose."
    },
    "support": {
      "type": "array",
      "description": "Evidence references supporting the claim.",
      "minItems": 1,
      "items": {
        "$ref": "https://evidara.dev/schemas/evidence-ref"
      }
    },
    "referenced_authorities": {
      "type": "array",
      "description": "Citations, provisions, or authorities detected in the source passage.",
      "items": {
        "type": "object",
        "required": ["text", "citation_type"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citation_type": {
            "type": "string",
            "minLength": 1
          },
          "normalized_reference": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "language": {
      "type": ["string", "null"],
      "description": "Primary language of the source passage.",
      "pattern": "^[a-z]{2}$"
    },
    "jurisdiction_id": {
      "type": ["string", "null"],
      "description": "Canonical primary jurisdiction reference when available. The full facet set lives in `jurisdiction_ids`.",
      "pattern": "^jur_[a-z0-9_]+$"
    },
    "jurisdiction_ids": {
      "type": "array",
      "description": "Canonical jurisdictions this insight applies to. Drives search-projection facets and overlay routing.",
      "items": {
        "type": "string",
        "pattern": "^jur_[a-z0-9_]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority_ids": {
      "type": "array",
      "description": "Canonical authorities (publishing or authoring) attached to this insight. Required for commentary insights.",
      "items": {
        "type": "string",
        "pattern": "^auth_[a-z0-9_]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_document_ids": {
      "type": "array",
      "description": "Canonical primary documents this insight comments on. Required and non-empty for commentary insights so search joins can resolve back to source.",
      "items": {
        "type": "string",
        "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "review_state": {
      "type": "string",
      "enum": [
        "machine_generated_unreviewed",
        "machine_verified",
        "editor_approved",
        "rejected",
        "stale"
      ]
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": ["string", "null"]
        },
        "prompt_version": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": [
        "passage_present",
        "citation_parseable",
        "section_anchor_resolved"
      ],
      "properties": {
        "passage_present": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "citation_parseable": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "section_anchor_resolved": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Additional non-canonical processing metadata.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
