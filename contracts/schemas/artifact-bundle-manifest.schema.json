{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/schemas/artifact-bundle-manifest",
  "title": "ArtifactBundleManifest",
  "description": "Immutable acquisition handoff object from platform-control to document-intelligence. One upstream snapshot may contain one or more sibling artifacts plus the frozen hints and defaults approved for processing.",
  "type": "object",
  "required": [
    "bundle_manifest_id",
    "manifest_version",
    "provenance",
    "source_snapshot_id",
    "source_origin_kind",
    "trust_tier",
    "snapshot_captured_at",
    "source_defaults",
    "parser_hints",
    "reference_context",
    "artifacts"
  ],
  "properties": {
    "bundle_manifest_id": {
      "type": "string",
      "pattern": "^abm_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Artifact bundle manifest identifier."
    },
    "manifest_version": {
      "type": "integer",
      "const": 1,
      "description": "Major version of the artifact bundle manifest contract."
    },
    "provenance": {
      "$ref": "https://evidara.dev/common/provenance"
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^snap_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Snapshot ID for the upstream item that yielded this bundle."
    },
    "snapshot_external_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Opaque external identifier from the upstream system, when one exists."
    },
    "upstream_locator": {
      "type": "string",
      "description": "Original upstream URL, path, or logical locator used to fetch the snapshot."
    },
    "source_origin_kind": {
      "type": "string",
      "enum": [
        "official_primary",
        "official_mirror",
        "licensed_provider",
        "community_curated",
        "tenant_internal"
      ],
      "description": "Origin category of the source content."
    },
    "trust_tier": {
      "type": "string",
      "enum": [
        "authoritative",
        "preferred",
        "supplemental",
        "untrusted"
      ],
      "description": "Operational trust level carried into DI resolution policies."
    },
    "snapshot_captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the upstream snapshot was captured or fetched."
    },
    "source_defaults": {
      "type": "object",
      "required": [
        "jurisdiction_id"
      ],
      "properties": {
        "jurisdiction_id": {
          "type": "string",
          "pattern": "^jur_[a-z0-9_]+$",
          "description": "Default jurisdiction assignment owned by platform-control."
        },
        "authority_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^auth_[a-z0-9_]+$",
          "description": "Default authority assignment owned by platform-control."
        },
        "language_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
          },
          "description": "Expected language codes for this source version."
        },
        "document_type_hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional source-level document type hint."
        }
      },
      "additionalProperties": false
    },
    "parser_hints": {
      "type": "object",
      "properties": {
        "expected_modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pdf",
              "html",
              "docx",
              "xml",
              "json",
              "text",
              "mixed"
            ]
          }
        },
        "expected_content_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preferred_primary_artifact_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "primary_document",
              "metadata",
              "attachment",
              "structured_payload",
              "headers"
            ]
          }
        },
        "ocr_expected": {
          "type": "boolean"
        },
        "attachment_policy": {
          "type": "string",
          "enum": [
            "ignore",
            "ingest_selected",
            "ingest_all"
          ]
        }
      },
      "additionalProperties": false
    },
    "di_overrides": {
      "type": "object",
      "properties": {
        "source_profile_ref": {
          "type": "string",
          "description": "Approved source-specific DI profile reference."
        },
        "jurisdiction_profile_ref": {
          "type": "string",
          "description": "Approved jurisdiction-specific DI profile reference."
        },
        "resolution_policy_ref": {
          "type": "string",
          "description": "Approved provenance-aware resolution policy reference."
        },
        "normalization_profile_ref": {
          "type": "string",
          "description": "Optional explicit normalization profile reference for difficult sources."
        }
      },
      "additionalProperties": false
    },
    "reference_context": {
      "type": "object",
      "required": [
        "reference_snapshot_policy"
      ],
      "properties": {
        "reference_snapshot_policy": {
          "type": "string",
          "enum": [
            "latest_approved",
            "pin_snapshot_set"
          ],
          "description": "How DI should select the mirrored jurisdiction/authority snapshot set."
        },
        "reference_snapshot_set_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^rss_[0-9a-hjkmnp-tv-z]{26}$",
          "description": "Pinned reference snapshot set, required when policy is pin_snapshot_set."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reference_snapshot_policy": {
                "const": "pin_snapshot_set"
              }
            },
            "required": [
              "reference_snapshot_policy"
            ]
          },
          "then": {
            "required": [
              "reference_snapshot_set_ref"
            ]
          },
          "else": {
            "properties": {
              "reference_snapshot_set_ref": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_role",
          "storage_ref"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^art_[0-9a-hjkmnp-tv-z]{26}$",
            "description": "Artifact identifier."
          },
          "artifact_role": {
            "type": "string",
            "enum": [
              "primary_document",
              "metadata",
              "attachment",
              "structured_payload",
              "headers"
            ],
            "description": "Semantic role of the artifact within the bundle."
          },
          "storage_ref": {
            "$ref": "https://evidara.dev/common/storage-object-ref"
          }
        },
        "additionalProperties": false
      }
    },
    "bundle_metadata": {
      "type": "object",
      "description": "Open metadata map for source-specific acquisition facts that should remain visible to DI.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
