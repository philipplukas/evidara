{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/schemas/document",
  "title": "Document",
  "description": "Canonical published document revision produced by document-intelligence.",
  "type": "object",
  "required": [
    "document_id",
    "document_revision",
    "processing_manifest_id",
    "provenance",
    "primary_artifact_id",
    "title",
    "processed_at",
    "processing_version",
    "lifecycle_status",
    "full_text",
    "body_text"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Stable logical document identifier."
    },
    "document_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Published revision for this logical document."
    },
    "processing_manifest_id": {
      "type": "string",
      "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Immutable DI processing result that produced this revision."
    },
    "provenance": {
      "$ref": "https://evidara.dev/common/provenance"
    },
    "primary_artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Primary artifact selected as the canonical anchor for this revision."
    },
    "jurisdiction_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^jur_[a-z0-9_]+$",
      "description": "Resolved or source-default jurisdiction reference when available."
    },
    "authority_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^auth_[a-z0-9_]+$",
      "description": "Resolved or source-default authority reference when available."
    },
    "title": {
      "type": "string",
      "description": "Canonical document title."
    },
    "document_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Normalized canonical document type.",
      "enum": ["law", "decision", "commentary", "rechtssatz", null]
    },
    "effective_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Resolved effective date when available."
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp for canonical publication."
    },
    "processing_version": {
      "type": "string",
      "description": "DI pipeline version that produced this revision."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "repealed",
        "withdrawn"
      ],
      "description": "Lifecycle state of the published document revision."
    },
    "full_text": {
      "type": "string",
      "description": "Normalized full document text."
    },
    "body_text": {
      "type": "string",
      "description": "Normalized body text used for sectionization and indexing."
    },
    "metadata": {
      "type": "object",
      "description": "Additional low-risk canonical metadata.",
      "properties": {
        "official_citation": {
          "type": "string",
          "description": "Canonical official publication citation when one can be derived reliably."
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "description": "Non-canonical extension area for experimental fields.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
