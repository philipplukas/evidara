{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidara.dev/schemas/processing-manifest",
  "title": "ProcessingManifest",
  "description": "Immutable processing result record owned by document-intelligence. Captures the exact profiles, reference snapshots, and published canonical refs for one document revision.",
  "type": "object",
  "required": [
    "processing_manifest_id",
    "manifest_version",
    "document_id",
    "document_revision",
    "processing_version",
    "status",
    "provenance",
    "input_bundle_manifest_ref",
    "selected_profiles"
  ],
  "properties": {
    "processing_manifest_id": {
      "type": "string",
      "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Immutable processing result identifier."
    },
    "manifest_version": {
      "type": "integer",
      "const": 1,
      "description": "Major version of the processing manifest contract."
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Stable logical document identifier."
    },
    "document_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Published revision produced by this processing result."
    },
    "processing_version": {
      "type": "string",
      "description": "DI pipeline version."
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "processing",
        "canonical_ready",
        "quarantined",
        "failed",
        "withdrawn",
        "skipped_duplicate"
      ],
      "description": "Processing status for the result. `quarantined` (ADR-0047) is neither success nor failure: processing completed and produced output whose extracted text cannot support the claim that it is law, so nothing was published to the canonical surfaces."
    },
    "provenance": {
      "$ref": "https://evidara.dev/common/provenance"
    },
    "input_bundle_manifest_ref": {
      "allOf": [
        {
          "$ref": "https://evidara.dev/common/manifest-ref"
        },
        {
          "properties": {
            "manifest_id": {
              "pattern": "^abm_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "manifest_type": {
              "const": "artifact_bundle_manifest"
            }
          }
        }
      ]
    },
    "selected_profiles": {
      "type": "object",
      "required": [
        "source_profile_ref",
        "jurisdiction_profile_ref",
        "resolution_policy_ref"
      ],
      "properties": {
        "source_profile_ref": {
          "type": "string"
        },
        "jurisdiction_profile_ref": {
          "type": "string"
        },
        "resolution_policy_ref": {
          "type": "string"
        },
        "normalization_profile_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reference_snapshot_set_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^rss_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Reference snapshot set actually used by processing."
    },
    "published_document_ref": {
      "allOf": [
        {
          "$ref": "https://evidara.dev/common/dataset-ref"
        },
        {
          "properties": {
            "surface_name": {
              "const": "published_documents"
            },
            "record_key": {
              "type": "object",
              "required": ["document_id", "processing_manifest_id"],
              "properties": {
                "document_id": {
                  "type": "string",
                  "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$"
                },
                "processing_manifest_id": {
                  "type": "string",
                  "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$"
                }
              }
            }
          },
          "required": ["record_key"]
        }
      ]
    },
    "published_sections_ref": {
      "allOf": [
        {
          "$ref": "https://evidara.dev/common/dataset-ref"
        },
        {
          "properties": {
            "surface_name": {
              "const": "published_sections"
            },
            "record_filter": {
              "type": "object",
              "required": ["document_id", "processing_manifest_id"],
              "properties": {
                "document_id": {
                  "type": "string",
                  "pattern": "^doc_[0-9a-hjkmnp-tv-z]{26}$"
                },
                "processing_manifest_id": {
                  "type": "string",
                  "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$"
                }
              }
            }
          },
          "required": ["record_filter"]
        }
      ]
    },
    "canonical_ready_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_processing_manifest_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^pm_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Older processing result superseded by this one."
    },
    "document_count": {
      "type": "integer",
      "minimum": 0
    },
    "section_count": {
      "type": "integer",
      "minimum": 0
    },
    "citation_count": {
      "type": "integer",
      "minimum": 0
    },
    "stages": {
      "type": "array",
      "description": "Per-stage timings and counts for this document's processing. Timings and counts ONLY: an entry does NOT say what the stage removed from the text (footnote apparatus, page furniture, a lifted Randtitel, a dropped citation) — that disclosure is ADR-0044's subject and is not implemented. An absent or empty array means the manifest does not carry stage timings, NOT that no stages ran. There is deliberately no 'persist' stage: the manifest is what persistence writes, so a stage covering that write cannot appear inside it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "duration_ms"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Closed vocabulary, in execution order. 'assemble' sits between 'extract' and 'enrich' because document construction genuinely runs there — enrichment mutates a document that must already exist.",
            "enum": [
              "normalize",
              "sectionize",
              "extract",
              "assemble",
              "enrich",
              "finalize"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "items_in": {
            "type": "integer",
            "minimum": 0,
            "description": "Absent when the stage did not measure an input count. Absent is not zero."
          },
          "items_out": {
            "type": "integer",
            "minimum": 0,
            "description": "Absent when the stage did not measure an output count. Absent is not zero."
          },
          "failed": {
            "type": "boolean",
            "description": "Present and true only when the stage raised. A failing stage is still recorded, before the exception propagates — a ledger that described only successful runs would be systematically absent for exactly the documents someone is debugging."
          },
          "error_type": {
            "type": "string",
            "description": "The exception's type name. Present only alongside failed: true."
          },
          "details": {
            "type": "object",
            "description": "Reserved for ADR-0044 transformation disclosure. Absent today, and its absence means 'not recorded', never 'nothing was removed'."
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "required": [
        "code",
        "summary"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "quarantine": {
      "type": "object",
      "description": "Why this result was withheld from the canonical corpus (ADR-0047). Present exactly when status is `quarantined`. Deliberately separate from `failure`: the two take opposite remedies — replay a failure, implement or fix the missing class for a quarantine — and merging them makes the queue undrainable.",
      "required": [
        "reason",
        "detail"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "no_text_layer",
            "below_content_floor",
            "no_sections_extracted",
            "unsupported_manifestation",
            "format_signature_mismatch"
          ],
          "description": "Closed taxonomy (ADR-0047 section 3). A new reason requires an entry here and a row in the ADR's table naming which of the two exits it takes, so `miscellaneous` cannot become the largest bucket."
        },
        "detail": {
          "type": "string",
          "description": "Human-readable statement of what was measured and why it failed the floor."
        },
        "extracted_chars": {
          "type": "integer",
          "minimum": 0
        },
        "min_extracted_chars": {
          "type": "integer",
          "minimum": 0
        },
        "legal_marker_count": {
          "type": "integer",
          "minimum": 0
        },
        "min_legal_markers": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "canonical_ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "published_document_ref",
          "published_sections_ref",
          "canonical_ready_at"
        ],
        "not": {
          "required": [
            "failure"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "published_document_ref"
              ]
            },
            {
              "required": [
                "published_sections_ref"
              ]
            },
            {
              "required": [
                "canonical_ready_at"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "processing",
              "withdrawn",
              "skipped_duplicate"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "published_document_ref"
              ]
            },
            {
              "required": [
                "published_sections_ref"
              ]
            },
            {
              "required": [
                "canonical_ready_at"
              ]
            },
            {
              "required": [
                "failure"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "quarantined"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "quarantine"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "published_document_ref"
              ]
            },
            {
              "required": [
                "published_sections_ref"
              ]
            },
            {
              "required": [
                "canonical_ready_at"
              ]
            },
            {
              "required": [
                "failure"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "quarantined"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "quarantine"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}