FROM python:3.12-slim@sha256:804ddf3251a60bbf9c92e73b7566c40428d54d0e79d3428194edf40da6521286

# Installs from `uv.lock`, not from `pyproject.toml`'s floors — see the note in
# `document-intelligence/Dockerfile` and #848. `uv.lock` and `.python-version` are part
# of the copied set for that reason: without the lock `--frozen` cannot resolve, and the
# build fails loudly rather than quietly falling back to a float.
COPY --from=ghcr.io/astral-sh/uv@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY pyproject.toml uv.lock .python-version README.md ./
COPY src ./src

RUN uv sync --frozen --no-dev --no-editable --extra service

EXPOSE 8091

CMD ["document_intelligence_runtime_ingress"]
