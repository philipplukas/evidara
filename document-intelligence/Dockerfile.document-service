# File-backed Document Service (GET /v1/documents/{id}/lean) for local dev.
# Content directory is mounted at /content (see docker-compose.yml, profile `lean`).

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DOCUMENT_SERVICE_CONTENT_DIR=/content \
    PORT=8090

WORKDIR /app

COPY document-intelligence/ /app/

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[service]"

EXPOSE 8090

CMD ["document_intelligence_document_service"]
