# Coordinator environment variables.
# Copy to .env and fill in secrets before deploying.

# Temporal
COORDINATOR_TEMPORAL_TARGET=localhost:7233
COORDINATOR_TEMPORAL_NAMESPACE=default
COORDINATOR_TEMPORAL_TASK_QUEUE=evidara-coordinator

# OpenHands
COORDINATOR_OPENHANDS_BASE_URL=http://localhost:3000

# Slack App
COORDINATOR_SLACK_BOT_TOKEN=xoxb-...
COORDINATOR_SLACK_SIGNING_SECRET=...

# Linear
COORDINATOR_LINEAR_WEBHOOK_SECRET=...
COORDINATOR_LINEAR_API_KEY=lin_api_...

# GitHub
COORDINATOR_GITHUB_TOKEN=ghp_...
COORDINATOR_GITHUB_REPO=philipplukas/evidara

# Gate config
COORDINATOR_GATE_CONFIG_PATH=/app/human-gates.yaml
