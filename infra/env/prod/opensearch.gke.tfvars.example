environment = "prod"

# Aligns with MacConfig platform contract namespace pattern (see vendor/platform-contract.yaml).
opensearch_namespace = "evidare-prod"

project_id = "your-gcp-project-id"
region     = "europe-west6"

node_locations = ["europe-west6-a", "europe-west6-b", "europe-west6-c"]
node_machine_type = "e2-standard-8"
node_disk_size_gb = 500
node_count        = 6

opensearch_replicas         = 3
opensearch_heap_size        = "4g"
opensearch_persistence_size = "500Gi"
