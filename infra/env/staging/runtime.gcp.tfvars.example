environment = "staging"

project_id = "evidara-staging"
region     = "europe-west6"

raw_artifact_bucket_name = "evidara-raw-artifacts-staging"
manifest_bucket_name     = "evidara-manifests-staging"

enable_cloud_sql = true

cloud_run_services = {
  "platform-control-api" = {
    image               = "europe-west6-docker.pkg.dev/evidara-staging/runtime/platform-control:latest"
    service_account_key = "platform_control_api"
    allow_unauthenticated = false
    vpc_connector = "projects/evidara-staging/locations/europe-west6/connectors/evidara-search-staging-connector"
    vpc_egress    = "PRIVATE_RANGES_ONLY"
  }

  "legal-search-api" = {
    image               = "europe-west6-docker.pkg.dev/evidara-staging/runtime/legal-search-api:latest"
    service_account_key = "legal_search_api"
    allow_unauthenticated = false
    env_vars = {
      OPENSEARCH_ALIAS_READ              = "evidara-documents-read-staging"
      OPENSEARCH_ALIAS_WRITE             = "evidara-documents-write-staging"
      OPENSEARCH_INDEX_SECTIONS           = "evidara-sections-read-staging"
      OPENSEARCH_INDEX_CITATIONS          = "evidara-citations-read-staging"
      OPENSEARCH_INDEX_PROJECTION_HISTORY = "evidara-projection-history-staging"
    }
    secret_env_vars = {
      OPENSEARCH_NODE = {
        secret_name = "opensearch_node"
      }
      OPENSEARCH_USERNAME = {
        secret_name = "opensearch_username"
      }
      OPENSEARCH_PASSWORD = {
        secret_name = "opensearch_password"
      }
    }
    vpc_connector = "projects/evidara-staging/locations/europe-west6/connectors/evidara-search-staging-connector"
    vpc_egress    = "PRIVATE_RANGES_ONLY"
  }
}
