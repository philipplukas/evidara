# Repository owner/name
github_owner    = "philipplukas"
repository_name = "evidara"

# Default environment model for current CD strategy.
environments = ["dev", "staging", "prod"]

# Repository-level variables used by CD workflows.
repository_variables = {
  GCP_REGION                           = "europe-west6"
  GCP_PROJECT_ID_DEV                   = "project-dacd6b7b-dc96-4534-b82"
  GCP_PROJECT_ID_STAGING               = "project-dacd6b7b-dc96-4534-b82"
  GCP_PROJECT_ID_PROD                  = "data-platform-prod-492214"
  GCP_ARTIFACT_PROJECT_ID              = "data-platform-dev-492214"
  ARTIFACT_REGISTRY_REPOSITORY         = "runtime"
  # GCP runtime publication/deploy is opt-in while the low-cost Hetzner path is active.
  ENABLE_GCP_ARTIFACT_REGISTRY         = "false"
  ENABLE_GCP_CLOUD_RUN_CD              = "false"
  # Cloud Run resource name prefix before -dev / -prod (see runtime.gcp.tfvars keys, e.g. platform-control-api).
  PLATFORM_CONTROL_SERVICE_NAME        = "platform-control-api"
  PLATFORM_CONTROL_WORKER_SERVICE_NAME = "platform-control-worker"
  LEGAL_SEARCH_API_SERVICE_NAME        = "legal-search-api"
  DI_CONSUMER_SERVICE_NAME             = "document-intelligence-consumer"
  DOCUMENT_INTELLIGENCE_DOCUMENT_SERVICE_NAME = "document-intelligence-document-service"
  DI_SURFACES_ROOT_URI_DEV             = "gs://evidara-document-intelligence-surfaces-dev/published"
  DI_SURFACES_ROOT_URI_STAGING         = "gs://evidara-document-intelligence-surfaces-staging/published"
  SMOKE_SEED_URL_DEV                   = "http://example.org"
  SMOKE_SEED_URL_STAGING               = "http://example.org"
  SMOKE_REQUEST_TIMEOUT_SECONDS_DEV    = "10"
  SMOKE_REQUEST_TIMEOUT_SECONDS_STAGING = "10"
  # ARC runner scale-set labels (see ADR-0024, incident #311). Values must match
  # the workflow `runs-on: ${{ vars.*_RUNNER_SCALE_SET || 'evidara-*' }}` fallbacks.
  LIGHT_RUNNER_SCALE_SET               = "evidara-light"
  HEAVY_RUNNER_SCALE_SET               = "evidara-heavy"
}

# Optional environment-scoped variables.
environment_variables = {
  dev     = {}
  staging = {}
  prod    = {}
}

# Do not commit real secret values.
# Pass secrets via TF_VAR_environment_secrets / TF_VAR_repository_secrets
# in your shell or CI instead.
# Example shape:
# environment_secrets = {
#   dev = {
#     GCP_WORKLOAD_IDENTITY_PROVIDER = "projects/123456/locations/global/workloadIdentityPools/github/providers/evidara"
#     GCP_SERVICE_ACCOUNT_DEV        = "gha-deployer-dev@evidara-dev.iam.gserviceaccount.com"
#     DATABRICKS_HOST                = "https://dbc-xxxxxxxx.cloud.databricks.com"
#     DATABRICKS_TOKEN               = "..."
#   }
#   staging = {
#     GCP_WORKLOAD_IDENTITY_PROVIDER = "projects/123456/locations/global/workloadIdentityPools/github/providers/evidara"
#     GCP_SERVICE_ACCOUNT_STAGING    = "gha-deployer-staging@project-dacd6b7b-dc96-4534-b82.iam.gserviceaccount.com"
#     E2E_SMOKE_STAGING_SLACK_WEBHOOK = "https://hooks.slack.com/services/..."
#   }
#   prod = {
#     GCP_WORKLOAD_IDENTITY_PROVIDER = "projects/123456/locations/global/workloadIdentityPools/github/providers/evidara"
#     GCP_SERVICE_ACCOUNT_PROD       = "gha-deployer-prod@evidara-prod.iam.gserviceaccount.com"
#     DATABRICKS_HOST                = "https://dbc-xxxxxxxx.cloud.databricks.com"
#     DATABRICKS_TOKEN               = "..."
#   }
# }
#
# Optional repository-level Actions secrets (TF_VAR_repository_secrets JSON), e.g. for
# `.github/workflows/evidara-cli-remote-smoke.yml` app-layer keys:
#
# repository_secrets = {
#   EVIDARA_PLATFORM_CONTROL_API_KEY = "..."
#   EVIDARA_LEGAL_SEARCH_API_KEY     = "..."
# }
#
# Do NOT store Google Cloud Run IAM ID tokens in repository_secrets: they expire quickly
# (~1h). The Evidara CLI remote smoke workflow mints Bearer tokens via WIF + impersonation
# using the environment secrets above. See infra/terraform/github/repo_settings/README.md.
