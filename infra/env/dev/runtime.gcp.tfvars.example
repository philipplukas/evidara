environment = "dev"

project_id = "evidara-dev"
region     = "europe-west6"

# Runtime Pub/Sub: unless you override `event_topic_names` / `event_subscriptions` below, the
# runtime_stack module defaults apply — including push subscriptions from
# `document-processing-status-updated` and `document-processed` to `platform-control-api`
# (see infra/terraform/gcp/runtime_stack/variables.tf). Environments with suffixed topic names
# must define matching subscriptions (pattern: infra/env/staging/runtime.gcp.tfvars.example).

raw_artifact_bucket_name = "evidara-raw-artifacts-dev"
manifest_bucket_name     = "evidara-manifests-dev"

# DI published Delta surfaces (GCS). Grants the document_intelligence runtime SA objectAdmin here
# (see google_storage_bucket_iam_member.document_intelligence_published_surfaces_object_admin).
document_intelligence_published_bucket_name = "evidara-document-intelligence-surfaces-dev"

# Push artifact-bundle events to the HTTP DI ingress (runtime image di-consumer / Dockerfile.runtime-ingress).
artifact_bundle_subscription_push = {
  subscription_key = "document-intelligence-artifact-bundle-available"
  target_service   = "di-consumer"
}

enable_cloud_sql = true

cloud_run_services = {
  "platform-control-api" = {
    image               = "europe-west6-docker.pkg.dev/evidara-dev/runtime/platform-control:latest"
    service_account_key = "platform_control_api"
    allow_unauthenticated = false
    # Use output vpc_connector_id from infra/terraform/opensearch/gke_stack
    vpc_connector = "projects/evidara-dev/locations/europe-west6/connectors/evidara-search-dev-connector"
    vpc_egress    = "PRIVATE_RANGES_ONLY"
    env_vars = {
      PLATFORM_CONTROL_GCP_PROJECT_ID      = "evidara-dev"
      PLATFORM_CONTROL_ARTIFACT_STORE_BACKEND = "gcs"
      PLATFORM_CONTROL_EVENT_PUBLISHER_BACKEND = "pubsub"
      PLATFORM_CONTROL_RAW_ARTIFACT_BUCKET = "evidara-raw-artifacts-dev"
      PLATFORM_CONTROL_RAW_ARTIFACT_PUBSUB_TOPIC = "raw-artifact-available"
      PLATFORM_CONTROL_ARTIFACT_BUNDLE_PUBSUB_TOPIC = "artifact-bundle-available"
      # Keep acquisition dispatch off the API process; `platform-control-worker` polls `dispatch_pending_runs`.
      PLATFORM_CONTROL_RUN_DISPATCH_BACKEND = "worker"
      # Mirror each Firecrawl webhook payload to /tmp for offline replay via
      # `pc ingest --from-fixture` during dev-loop work. /tmp is the only
      # container-writable path on Cloud Run without a mounted volume, so the
      # log is ephemeral (rotates with each revision). For a durable audit
      # trail on staging/prod, promote to a GCS mount — see #254.
      PLATFORM_CONTROL_FIRECRAWL_WEBHOOK_RECORD_DIR = "/tmp/firecrawl-webhook-log"
    }
    secret_env_vars = {
      PLATFORM_CONTROL_DATABASE_URL = {
        secret_name = "platform_control_dsn"
      }
      PLATFORM_CONTROL_FIRECRAWL_API_KEY = {
        secret_name = "firecrawl_api_key"
      }
      PLATFORM_CONTROL_FIRECRAWL_WEBHOOK_SECRET = {
        secret_name = "firecrawl_webhook"
      }
      # Optional scoped keys (see docs/adr/adr-0020-api-authentication.md):
      # PLATFORM_CONTROL_OPERATOR_API_KEY = { secret_name = "platform_control_operator_api_key" }
      # PLATFORM_CONTROL_SERVICE_API_KEY = { secret_name = "platform_control_service_api_key" }
      # Legacy full-access key when scoped keys are not used:
      # PLATFORM_CONTROL_API_KEY = { secret_name = "platform_control_api_key" }
    }
  }

  "legal-search-api" = {
    image               = "europe-west6-docker.pkg.dev/evidara-dev/runtime/legal-search-api:latest"
    service_account_key = "legal_search_api"
    allow_unauthenticated = false
    vpc_connector = "projects/evidara-dev/locations/europe-west6/connectors/evidara-search-dev-connector"
    vpc_egress    = "PRIVATE_RANGES_ONLY"
    env_vars = {
      OPENSEARCH_ALIAS_READ              = "evidara-documents-read-dev"
      OPENSEARCH_ALIAS_WRITE             = "evidara-documents-write-dev"
      OPENSEARCH_INDEX_SECTIONS           = "evidara-sections-read-dev"
      OPENSEARCH_INDEX_CITATIONS          = "evidara-citations-read-dev"
      OPENSEARCH_INDEX_PROJECTION_HISTORY = "evidara-projection-history-dev"
      DOCUMENT_INTELLIGENCE_BASE_URL      = "https://document-intelligence-document-service-dev.example.run.app"
    }
    secret_env_vars = {
      OPENSEARCH_NODE = {
        secret_name = "opensearch_node"
      }
      OPENSEARCH_USERNAME = {
        secret_name = "opensearch_username"
      }
      OPENSEARCH_PASSWORD = {
        secret_name = "opensearch_password"
      }
      DOCUMENT_INTELLIGENCE_API_KEY = {
        secret_name = "document_service_bearer_token"
      }
    }
  }

  "document-intelligence-document-service" = {
    image                 = "europe-west6-docker.pkg.dev/evidara-dev/runtime/document-intelligence-document-service:latest"
    service_account_key   = "document_intelligence"
    allow_unauthenticated = true
    startup_probe_path    = "/health"
    liveness_probe_path   = "/health"
    env_vars = {
      DI_SURFACES_ROOT_URI = "gs://evidara-document-intelligence-surfaces-dev/published"
    }
    secret_env_vars = {
      DOCUMENT_SERVICE_BEARER_TOKEN = {
        secret_name = "document_service_bearer_token"
      }
    }
  }

  "platform-control-admin" = {
    image                 = "europe-west6-docker.pkg.dev/evidara-dev/runtime/platform-control-admin:latest"
    service_account_key   = "platform_control_admin"
    allow_unauthenticated = true
    env_vars = {
      PLATFORM_CONTROL_API_URL = "https://platform-control-api-dev.example.run.app"
    }
  }

  "legal-search-frontend" = {
    image                 = "europe-west6-docker.pkg.dev/evidara-dev/runtime/legal-search-frontend:latest"
    service_account_key   = "legal_search_frontend"
    allow_unauthenticated = true
    env_vars = {
      NEXT_PUBLIC_API_URL              = "https://legal-search-api-dev.example.run.app"
      NEXT_PUBLIC_CONTROL_PANEL_URL    = "https://platform-control-admin-dev.example.run.app"
    }
  }

  "platform-control-worker" = {
    image               = "europe-west6-docker.pkg.dev/evidara-dev/runtime/platform-control-worker:latest"
    service_account_key = "platform_control_worker"
    allow_unauthenticated = false
    min_instance_count  = 1
    max_instance_count  = 1
    vpc_connector = "projects/evidara-dev/locations/europe-west6/connectors/evidara-search-dev-connector"
    vpc_egress    = "PRIVATE_RANGES_ONLY"
    env_vars = {
      # Keep worker artifact storage and event publication aligned with platform-control-api so
      # async provider runs emit bundle manifests DI can read cross-service.
      PLATFORM_CONTROL_GCP_PROJECT_ID = "evidara-dev"
      PLATFORM_CONTROL_ARTIFACT_STORE_BACKEND = "gcs"
      PLATFORM_CONTROL_EVENT_PUBLISHER_BACKEND = "pubsub"
      PLATFORM_CONTROL_RAW_ARTIFACT_BUCKET = "evidara-raw-artifacts-dev"
      PLATFORM_CONTROL_RAW_ARTIFACT_PUBSUB_TOPIC = "raw-artifact-available"
      PLATFORM_CONTROL_ARTIFACT_BUNDLE_PUBSUB_TOPIC = "artifact-bundle-available"
      PLATFORM_CONTROL_RUN_DISPATCH_BACKEND = "worker"
    }
    secret_env_vars = {
      PLATFORM_CONTROL_DATABASE_URL = {
        secret_name = "platform_control_dsn"
      }
      PLATFORM_CONTROL_FIRECRAWL_API_KEY = {
        secret_name = "firecrawl_api_key"
      }
    }
  }

  # HTTP ingress: Pub/Sub push → /internal/events/artifact-bundles:process (not pull).
  "di-consumer" = {
    image                 = "europe-west6-docker.pkg.dev/evidara-dev/runtime/di-consumer:latest"
    service_account_key   = "document_intelligence"
    allow_unauthenticated = false
    startup_probe_path    = "/health"
    liveness_probe_path   = "/health"
    env_vars = {
      DI_GCP_PROJECT_ID                  = "evidara-dev"
      DI_EVENT_PUBLISHER_BACKEND         = "pubsub"
      DI_STATUS_TOPIC_NAME               = "document-processing-status-updated"
      DI_PROCESSED_TOPIC_NAME            = "document-processed"
      DI_DOCUMENT_PROCESSED_PUBSUB_TOPIC = "document-processed"
      DI_SURFACES_ROOT_URI               = "gs://evidara-document-intelligence-surfaces-dev/published"
      DI_PROCESSING_VERSION              = "0.1.0-dev"
      DI_PARSER_BACKEND                  = "legacy"
    }
  }
}

cloud_run_jobs = {
  "platform-control-db-migrate" = {
    image               = "europe-west6-docker.pkg.dev/evidara-dev/runtime/platform-control:latest"
    service_account_key = "platform_control_api"
    command             = ["sh"]
    args = [
      "-lc",
      <<-EOT
      set -euo pipefail
      if [ -f /app/alembic.ini ]; then
        (cd /app && alembic -c alembic.ini upgrade head) || echo "Alembic migration failed; applying metadata bootstrap fallback."
      else
        echo "Missing /app/alembic.ini; applying metadata bootstrap fallback."
      fi
      python - <<'PY'
      import asyncio
      import platform_control.models  # noqa: F401
      from platform_control.config import get_settings
      from platform_control.models.base import Base
      from sqlalchemy.ext.asyncio import create_async_engine


      async def main() -> None:
          engine = create_async_engine(get_settings().database_url)
          async with engine.begin() as conn:
              await conn.run_sync(Base.metadata.create_all)
          await engine.dispose()


      asyncio.run(main())
      print("platform-control schema bootstrap complete")
      PY
      EOT
    ]
    timeout_seconds     = 900
    max_retries         = 1
    vpc_connector       = "projects/evidara-dev/locations/europe-west6/connectors/evidara-search-dev-connector"
    vpc_egress          = "PRIVATE_RANGES_ONLY"
    cloud_sql_instances = ["evidara-dev:europe-west6:evidara-control-dev"]
    secret_env_vars = {
      PLATFORM_CONTROL_DATABASE_URL = {
        secret_name = "platform_control_dsn"
      }
    }
  }

  "os-alias-check" = {
    image               = "curlimages/curl:8.10.1"
    service_account_key = "legal_search_api"
    command             = ["sh"]
    args = [
      "-lc",
      "set -euo pipefail; NODE=\"$${OPENSEARCH_NODE%/}\"; AUTH=\"$${OPENSEARCH_USERNAME}:$${OPENSEARCH_PASSWORD}\"; for alias in \"$${OPENSEARCH_ALIAS_READ}\" \"$${OPENSEARCH_ALIAS_WRITE}\"; do if ! curl -fsS -u \"$${AUTH}\" \"$${NODE}/_alias/$${alias}\" >/dev/null; then echo \"Missing OpenSearch alias '$${alias}' in dev. Run job os-alias-bootstrap-dev, then rerun smoke.\" >&2; exit 1; fi; done; echo 'OpenSearch aliases exist and are reachable.'"
    ]
    timeout_seconds = 300
    max_retries     = 0
    vpc_connector   = "projects/evidara-dev/locations/europe-west6/connectors/evidara-search-dev-connector"
    vpc_egress      = "PRIVATE_RANGES_ONLY"
    env_vars = {
      OPENSEARCH_ALIAS_READ  = "evidara-documents-read-dev"
      OPENSEARCH_ALIAS_WRITE = "evidara-documents-write-dev"
    }
    secret_env_vars = {
      OPENSEARCH_NODE = {
        secret_name = "opensearch_node"
      }
      OPENSEARCH_USERNAME = {
        secret_name = "opensearch_username"
      }
      OPENSEARCH_PASSWORD = {
        secret_name = "opensearch_password"
      }
    }
  }

  "os-alias-bootstrap" = {
    image               = "curlimages/curl:8.10.1"
    service_account_key = "legal_search_api"
    command             = ["sh"]
    args = [
      "-lc",
      <<-EOT
      set -euo pipefail
      NODE="$${OPENSEARCH_NODE%/}"
      AUTH="$${OPENSEARCH_USERNAME}:$${OPENSEARCH_PASSWORD}"

      if ! curl -fsS -u "$${AUTH}" "$${NODE}/$${OPENSEARCH_INDEX_NAME}" >/dev/null 2>&1; then
        create_status="$(curl -sS -u "$${AUTH}" \
          -o /tmp/index-create-response.txt \
          -w "%%{http_code}" \
          -H "Content-Type: application/json" \
          -X PUT "$${NODE}/$${OPENSEARCH_INDEX_NAME}" \
          -d '{"settings":{"number_of_shards":1,"number_of_replicas":1}}' || true)"
        if [ "$${create_status}" != "200" ] && [ "$${create_status}" != "201" ] && [ "$${create_status}" != "400" ]; then
          echo "Failed creating index $${OPENSEARCH_INDEX_NAME} (HTTP $${create_status})."
          cat /tmp/index-create-response.txt
          exit 1
        fi
      fi

      for alias in "$${OPENSEARCH_ALIAS_READ}" "$${OPENSEARCH_ALIAS_WRITE}"; do
        delete_status="$(curl -sS -u "$${AUTH}" -o /tmp/delete-alias-index-response.txt -w "%%{http_code}" -X DELETE "$${NODE}/$${alias}" || true)"
        if [ "$${delete_status}" != "200" ] && [ "$${delete_status}" != "404" ] && [ "$${delete_status}" != "400" ]; then
          echo "Failed deleting legacy index named $${alias} (HTTP $${delete_status})."
          cat /tmp/delete-alias-index-response.txt
          exit 1
        fi

        unalias_status="$(curl -sS -u "$${AUTH}" -o /tmp/remove-alias-response.txt -w "%%{http_code}" -X DELETE "$${NODE}/_all/_alias/$${alias}" || true)"
        if [ "$${unalias_status}" != "200" ] && [ "$${unalias_status}" != "404" ]; then
          echo "Failed removing alias $${alias} from existing indices (HTTP $${unalias_status})."
          cat /tmp/remove-alias-response.txt
          exit 1
        fi
      done

      alias_status="$(curl -sS -u "$${AUTH}" \
        -o /tmp/alias-update-response.txt \
        -w "%%{http_code}" \
        -H "Content-Type: application/json" \
        -X POST "$${NODE}/_aliases" \
        -d "{\"actions\":[{\"add\":{\"alias\":\"$${OPENSEARCH_ALIAS_READ}\",\"index\":\"$${OPENSEARCH_INDEX_NAME}\"}},{\"add\":{\"alias\":\"$${OPENSEARCH_ALIAS_WRITE}\",\"index\":\"$${OPENSEARCH_INDEX_NAME}\",\"is_write_index\":true}}]}")"

      if [ "$${alias_status}" -lt 200 ] || [ "$${alias_status}" -ge 300 ]; then
        echo "Failed updating aliases (HTTP $${alias_status})."
        cat /tmp/alias-update-response.txt
        exit 1
      fi

      echo "OpenSearch aliases now point to $${OPENSEARCH_INDEX_NAME}."
      EOT
    ]
    timeout_seconds = 300
    max_retries     = 0
    vpc_connector   = "projects/evidara-dev/locations/europe-west6/connectors/evidara-search-dev-connector"
    vpc_egress      = "PRIVATE_RANGES_ONLY"
    env_vars = {
      OPENSEARCH_INDEX_NAME  = "evidara-documents-dev-v1"
      OPENSEARCH_ALIAS_READ  = "evidara-documents-read-dev"
      OPENSEARCH_ALIAS_WRITE = "evidara-documents-write-dev"
    }
    secret_env_vars = {
      OPENSEARCH_NODE = {
        secret_name = "opensearch_node"
      }
      OPENSEARCH_USERNAME = {
        secret_name = "opensearch_username"
      }
      OPENSEARCH_PASSWORD = {
        secret_name = "opensearch_password"
      }
    }
  }
}

# --- Monitoring & Alerting ---
# Set enable_monitoring = true and provide notification targets to
# provision Cloud Monitoring alert policies.
# See docs/adr/sli-slo-definitions.md for SLI/SLO details.

enable_monitoring             = false
monitoring_notification_email = ""
# monitoring_slack_webhook_url = ""  # Set via TF_VAR or secrets

# --- Optional billing guardrails (Cloud Billing budgets) ---
# Project-scoped monthly budget with % thresholds (see infra/terraform/gcp/runtime_stack/billing_guardrails.tf).
# Alerts do not stop spend. Applier needs billing budget permissions on the billing account.
#
# enable_billing_budget                 = true
# billing_account_id                    = "012345-67890A-BCDEF0" # Billing → Account management
# billing_budget_amount_units           = "500"
# billing_budget_currency_code          = "EUR"
# billing_budget_notification_emails    = ["ops-alerts@example.com"]
# billing_budget_disable_default_iam_recipients = false

enable_billing_budget = false

runtime_service_account_ids = {
  platform_control_api    = "evd-pc-api"
  platform_control_admin  = "evd-pc-admin"
  platform_control_worker = "evd-pc-worker"
  legal_search_api        = "evd-ls-api"
  legal_search_frontend   = "evd-ls-frontend"
  document_intelligence   = "evd-di-consumer"
}
