{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LakehouseBucketRead",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::evidara-lakehouse"]
    },
    {
      "Sid": "LakehouseCanonicalRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::evidara-lakehouse/canonical/*"]
    }
  ]
}
